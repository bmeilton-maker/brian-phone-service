# ---- Provider selection ----
# bland (default, proven) | xai | openai_live (GPT-Live-1 trial) | mock (no network; demo/CI)
PHONE_PROVIDER=bland

# ---- Bland ----
BLAND_API_KEY=
BLAND_VOICE=maya
BLAND_MODEL=base
BLAND_BACKGROUND_TRACK=office
BLAND_TEMPERATURE=0.5
BLAND_FROM_NUMBER=

# ---- xAI (Grok Voice Agent API) ----
XAI_API_KEY=
XAI_VOICE=eve
XAI_REALTIME_MODEL=grok-voice-latest
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
# Model used for post-call transcript -> structured result extraction
XAI_EXTRACTION_MODEL=grok-4-fast
# Direct SIP number registered with xAI (POST https://api.x.ai/v2/phone-numbers). E.164.
XAI_SIP_NUMBER=
# Signing secret returned by xAI when the SIP number was registered
XAI_WEBHOOK_SECRET=
# Turn-taking: pause (ms) after the human stops before the agent replies. 400 ~= snappy 0.5s feel.
XAI_VAD_SILENCE_MS=400
XAI_VAD_THRESHOLD=0.5
XAI_VAD_PREFIX_PADDING_MS=300
# Agent stays silent after pickup until the human says hello, up to this many ms, then opens anyway.
XAI_GREETING_WAIT_MS=3000

# ---- OpenAI GPT-Live-1 (openai_live; Twilio Media Streams bridge, see docs/OPENAI_LIVE_RUNBOOK.md) ----
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
# Voice: willow (default, Brian's pick) | marin | gleam | meridian | quartz | ripple | vesper | stone | delta | cinder
OPENAI_LIVE_VOICE=willow
# Responses-delegation backend that runs report_outcome / ask_owner / end_call. gpt-5.6-luna is the cheaper option.
OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-terra
# Optional backend tuning: reasoning effort (e.g. low) and service tier (auto | default | flex | priority)
OPENAI_LIVE_BACKEND_REASONING_EFFORT=
OPENAI_LIVE_BACKEND_SERVICE_TIER=
# Agent stays silent after pickup until the human says hello, up to this many ms, then opens anyway.
OPENAI_LIVE_GREETING_WAIT_MS=3000
# Hangup: after end_call or a goodbye, wait up to this long for the agent's goodbye audio to START (covers one backend
# round trip); once it is speaking the goodbye is allowed to finish and the line drops ~0.5 s + Twilio playout later.
OPENAI_LIVE_HANGUP_DELAY_MS=3000
# Hang up on farewell intent (the agent's goodbye sentence, or the callee's goodbye followed by agent silence), not only
# when the backend calls end_call. Set false to fall back to end_call-only hangup.
OPENAI_LIVE_FAREWELL_HANGUP=true
# After the callee says goodbye, hang up once the agent has stayed silent this long (doubled while the backend is mid-request;
# the agent's own goodbye ends the call sooner).
OPENAI_LIVE_FAREWELL_SILENCE_MS=2500
# Drop the agent audio still queued at Twilio when the callee interrupts with real content (not "mm-hm"/"okay").
OPENAI_LIVE_CLEAR_ON_BARGE_IN=true
# Keep a 30-day recording of the session at OpenAI (project must allow storage)
OPENAI_LIVE_STORE=false

# ---- Twilio (dials the PSTN leg for xAI and openai_live) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Verify X-Twilio-Signature on webhooks (default true). Only disable while debugging a tunnel that rewrites URLs.
TWILIO_VALIDATE_SIGNATURE=true

# ---- Service ----
PORT=8787
# Public HTTPS base URL of this service (ngrok/Cloudflare tunnel/etc). Needed for xAI + Twilio webhooks and the openai_live media WebSocket.
PUBLIC_BASE_URL=
# Shared secret required on HTTP API calls (Authorization: Bearer <token>). Leave blank to disable (local only).
PHONE_SERVICE_TOKEN=
DATA_DIR=./data
LOG_LEVEL=info
DEFAULT_MAX_DURATION_SECONDS=600
# How long the xAI / openai_live agent will hold for an answer from Brian before taking a callback (needs_user flow)
NEEDS_USER_HOLD_SECONDS=45
