# ---- Provider selection ----
# bland (default, proven) | xai | mock (no network; demo/CI)
PHONE_PROVIDER=bland

# ---- Bland ----
BLAND_API_KEY=
BLAND_VOICE=maya
BLAND_MODEL=base
BLAND_BACKGROUND_TRACK=office
BLAND_TEMPERATURE=0.5
BLAND_FROM_NUMBER=

# ---- xAI (Grok Voice Agent API) ----
XAI_API_KEY=
XAI_VOICE=eve
XAI_REALTIME_MODEL=grok-voice-latest
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
# Model used for post-call transcript -> structured result extraction
XAI_EXTRACTION_MODEL=grok-4-fast
# Direct SIP number registered with xAI (POST https://api.x.ai/v2/phone-numbers). E.164.
XAI_SIP_NUMBER=
# Signing secret returned by xAI when the SIP number was registered
XAI_WEBHOOK_SECRET=

# ---- Twilio (dials the PSTN leg for xAI, then bridges into xAI SIP) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Service ----
PORT=8787
# Public HTTPS base URL of this service (ngrok/Cloudflare tunnel/etc). Needed for xAI + Twilio webhooks.
PUBLIC_BASE_URL=
# Shared secret required on HTTP API calls (Authorization: Bearer <token>). Leave blank to disable (local only).
PHONE_SERVICE_TOKEN=
DATA_DIR=./data
LOG_LEVEL=info
DEFAULT_MAX_DURATION_SECONDS=600
# How long the xAI agent will hold for an answer from Brian before taking a callback (needs_user flow)
NEEDS_USER_HOLD_SECONDS=45
